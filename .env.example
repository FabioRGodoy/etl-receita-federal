# ==============================================
# Database Configuration
# ==============================================
DB_HOST=localhost              # Host do PostgreSQL (localhost, IP privado ou domínio)
DB_PORT=5432                   # Porta do PostgreSQL (padrão: 5432)
DB_NAME=etl_receita_federal    # Nome do banco de dados
DB_USER=postgres               # Usuário do PostgreSQL
DB_PASSWORD=sua_senha_aqui     # Senha forte (NUNCA commitar arquivo .env real!)

# ==============================================
# ETL Configuration
# ==============================================
BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/
BATCH_SIZE=1000                # Registros por batch INSERT
DOWNLOAD_TIMEOUT=600000        # Timeout de download em ms (10 minutos)
DOWNLOAD_RETRIES=8             # Número máximo de tentativas de download
DOWNLOAD_RETRY_DELAY_MS=5000   # Delay inicial entre retries (ms)
DOWNLOAD_INACTIVITY_TIMEOUT=120000  # Timeout de inatividade (2 minutos)

# ==============================================
# Paths
# ==============================================
TEMP_DIR=./temp                # Diretório para arquivos ZIP temporários
LOG_DIR=./logs                 # Diretório para logs do sistema

# ==============================================
# Optional - Test Mode
# ==============================================
TESTMODE=false                 # true para modo de teste (não usar em produção)
